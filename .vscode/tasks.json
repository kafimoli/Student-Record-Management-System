
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Terminate previous program",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "taskkill /F /IM main.exe >nul 2>&1 || exit /b 0"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build active file",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\main.exe",
                "${file}"
            ],
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "dependsOn": "Terminate previous program",
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
